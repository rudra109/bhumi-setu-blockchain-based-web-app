# =============================================================================
# Land Registry API  –  Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=4000

# Allowed origin for CORS (React / Vite dev server)
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Hyperledger Fabric – test-network paths
#
# FABRIC_ORG_PATH   → absolute path to fabric-samples/test-network/organizations
#                     e.g. C:/Users/you/fabric-samples/test-network/organizations
#
# FABRIC_PEER_ENDPOINT      → host:port of the peer gRPC endpoint  (default: localhost:7051)
# FABRIC_PEER_HOST_ALIAS    → TLS server-name override              (default: peer0.org1.example.com)
# FABRIC_MSPID              → MSP ID of the submitting organisation (default: Org1MSP)
# FABRIC_USER               → wallet user whose certs are in MSP    (default: User1)
# FABRIC_CHANNEL            → channel name                          (default: mychannel)
# FABRIC_CHAINCODE          → deployed chaincode / contract name    (default: landregistry)
# -----------------------------------------------------------------------------
FABRIC_ORG_PATH=C:/Users/mkuma/OneDrive/Desktop/New folder (2)/blockchain project/fabric-samples/test-network/organizations
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_MSPID=Org1MSP
FABRIC_USER=User1
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=landregistry

# -----------------------------------------------------------------------------
# Polygon Amoy – AnchorRegistry contract
#
# POLYGON_RPC_URL   → Amoy JSON-RPC endpoint
# CONTRACT_ADDRESS  → deployed AnchorRegistry contract address (with 0x prefix)
# PRIVATE_KEY       → EOA private key used to sign Polygon txs  (with or without 0x)
#
# Leave CONTRACT_ADDRESS / PRIVATE_KEY empty to disable Polygon anchoring.
# -----------------------------------------------------------------------------
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=0xYourAnchorRegistryAddressHere
PRIVATE_KEY=your_private_key_here_without_or_with_0x_prefix
